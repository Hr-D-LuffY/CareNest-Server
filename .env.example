NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/carenest

# Generate real values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-string-of-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

FRONTEND_URL=http://localhost:3000

# Optional: enables the seatsLeft cache and API rate limiting (e.g. redis://localhost:6379).
# Left blank, room reads skip straight to Postgres and rate limiting fails open (no limit enforced)
# — nothing else needs Redis running.
REDIS_URL=

# bKash Tokenized Checkout. Set all six or none (production requires all six). Sandbox base URL:
#   https://tokenized.sandbox.bka.sh/v1.2.0-beta   (production: https://tokenized.pay.bka.sh/v1.2.0-beta)
# BKASH_CALLBACK_URL must be publicly reachable, e.g. https://<your-host>/api/v1/payment/bkash/callback
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payment/bkash/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@vrbg3kvx

# AI features (guardian care assistant, admin insights). All optional: a provider without a key is
# skipped, and with no key at all the AI routes answer 503 while the rest of the app runs normally.
# Providers are tried in AI_PROVIDER_ORDER; if one fails or is out of budget, the next one answers.
# Free keys: Gemini https://aistudio.google.com, Groq https://console.groq.com, OpenRouter https://openrouter.ai
# Free tiers may log prompts, so the code never sends medical data, contact details or guardian names.
AI_PROVIDER_ORDER=gemini,groq,openrouter
AI_REQUEST_TIMEOUT_MS=20000

GEMINI_API_KEY=
# Free tier: gemini-3.5-flash-lite allows 500 requests/day; the other Flash models only 20.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_REQUESTS=450

GROQ_API_KEY=
# Free plan: 30 requests/min, 8K tokens/min, 200K tokens/day. Tokens run out before requests do.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_DAILY_REQUESTS=900
GROQ_DAILY_TOKENS=170000

OPENROUTER_API_KEY=
# Free models are capped at 50 requests/day. Pick a ":free" model that supports tools.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_DAILY_REQUESTS=45
