NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/carenest

# Generate real values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-string-of-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

FRONTEND_URL=http://localhost:3000

# Not required yet — needed by later features
REDIS_URL=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@vrbg3kvx
