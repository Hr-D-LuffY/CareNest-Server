// One row per bKash top-up attempt. A row is created PENDING when the guardian starts checkout and
// only flips to SUCCESS after our own Execute/Query Payment call confirms it (never on the redirect
// alone), which is also what credits the wallet.
model Payment {
  id String @id @default(uuid())

  guardianId String
  guardian   GuardianProfile @relation(fields: [guardianId], references: [id])

  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("BDT")
  status   PaymentStatus @default(PENDING)

  // our merchantInvoiceNumber sent to bKash; unique so an invoice is never reused
  transactionId    String  @unique
  gatewayPaymentId String? @unique // bKash paymentID, returned by Create Payment; the callback looks the row up by it
  gatewayTrxId     String? // bKash trxID, returned by Execute Payment once the money has moved
  gatewayResponse  Json? // raw Execute/Query payload, kept for audit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walletTransaction WalletTransaction?

  @@index([guardianId, createdAt])
  @@map("payments")
}
