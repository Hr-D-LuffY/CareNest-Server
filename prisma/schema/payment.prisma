model Payment {
  id String @id @default(uuid())

  guardianId String
  guardian   GuardianProfile @relation(fields: [guardianId], references: [id])

  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("BDT")
  status   PaymentStatus @default(PENDING)

  // our tran_id sent to SSLCommerz; the gateway echoes it back on callback / IPN
  transactionId     String  @unique
  gatewaySessionKey String?
  gatewayValId      String? // returned by the gateway, used to validate the payment
  gatewayResponse   Json? // raw validation payload, kept for audit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walletTransaction WalletTransaction?

  @@index([guardianId, createdAt])
  @@map("payments")
}
