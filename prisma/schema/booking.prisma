model Booking {
  id String @id @default(uuid())

  childId String
  child   Child  @relation(fields: [childId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  // denormalised from child so wallet checks and the 30-day cancellation count skip a join
  guardianId String
  guardian   GuardianProfile @relation(fields: [guardianId], references: [id])

  // the calendar date of the session; capacity and double-booking are checked per date
  sessionDate DateTime @db.Date

  status       BookingStatus @default(PENDING)
  cancelledAt  DateTime?
  estimatedFee Decimal       @db.Decimal(12, 2)
  finalFee     Decimal?      @db.Decimal(12, 2) // set at check-out

  // set when the wallet could not cover the fee at check-out
  insufficientBalance Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkinLog         CheckinLog?
  transportBooking   TransportBooking?
  waitlistEntry      WaitlistEntry? // the waitlist entry this booking was promoted from
  ratings            Rating[]
  walletTransactions WalletTransaction[]

  @@index([roomId, sessionDate, status]) // seatsLeft count
  @@index([guardianId, cancelledAt]) // cancellationPenalty count
  @@index([childId, sessionDate, status]) // double-booking check
  @@map("bookings")
}

model CheckinLog {
  id String @id @default(uuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  staffId String
  staff   StaffProfile @relation(fields: [staffId], references: [id])

  checkInAt  DateTime
  checkOutAt DateTime?
  hoursUsed  Decimal?  @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@map("checkin_logs")
}
