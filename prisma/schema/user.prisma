model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String? // null for Google-only accounts
  googleId     String? @unique
  role         Role    @default(GUARDIAN)

  profilePhoto         String? // Cloudinary secure_url, what the frontend displays
  profilePhotoPublicId String? // needed later to delete or replace the old image

  // hash of the current refresh token; cleared on logout, replaced on rotation
  refreshTokenHash String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardianProfile GuardianProfile?
  staffProfile    StaffProfile?
  auditLogs       AuditLog[]

  @@map("users")
}
